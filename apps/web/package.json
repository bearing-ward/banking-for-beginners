{
  "name": "@bfb/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tool.json"
  },
  "dependencies": {
    "@bfb/lessons": "workspace:*",
    "@effect/platform-browser": "4.1.4",
    "@foldkit/ui": "0.170.0",
    "@foldworks/ui": "0.2.0",
    "@stylexjs/stylex": "0.19.2",
    "effect": "4.1.4",
    "foldkit": "0.170.0",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@foldkit/devtools": "0.170.0",
    "@foldkit/vite-plugin": "0.29.0",
    "@stylexjs/unplugin": "0.19.2"
  },
  "hvs": {
    "checks": {
      "projects": [
        {
          "config": "tsconfig.json",
          "environment": "browser"
        },
        {
          "config": "tsconfig.tool.json",
          "environment": "tool"
        }
      ]
    }
  }
}
